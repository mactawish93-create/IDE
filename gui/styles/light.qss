QMainWindow, QWidget {
    background-color: #F8F9FA;
    color: #212529;
    font-family: 'Segoe UI', sans-serif;
}

QFrame {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

QTextEdit, QTreeView {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    color: #212529;
}

QPushButton {
    background-color: #E9ECEF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 6px 12px;
    color: #495057;
}

QPushButton:hover {
    background-color: #DEE2E6;
}

QPushButton#run_button {
    background-color: #0D6EFD;
    color: white;
    border: 1px solid #0D6EFD;
    font-weight: bold;
}

QPushButton#run_button:hover {
    background-color: #0B5ED7;
}

/* СТИЛИЗАЦИЯ ВКЛАДОК ДЛЯ СВЕТЛОЙ ТЕМЫ */
QTabWidget::panel {
    border: 1px solid #DEE2E6;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color: #E9ECEF;
    color: #495057;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border: 1px solid #DEE2E6;
    border-bottom: none;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #0D6EFD;
    border-bottom: 2px solid #0D6EFD;
    font-weight: bold;
}

QTabBar::tab:hover {
    background-color: #DEE2E6;
}

/* Специальный стиль для кнопки STOP */
QPushButton#stop_button {
    background-color: #3d1a24;
    color: #FF5555;
    border: 1px solid #FF5555;
}

QPushButton#stop_button:hover {
    background-color: #FF5555;
    color: #110B1C;
}

QPushButton#stop_button:disabled {
    background-color: #22141A;
    color: #55333D;
    border: 1px solid #44222B;
}

/* Подсветка кнопок управления безрамочным окном */
QPushButton#window_close_button:hover {
    background-color: #E81123 !important;
    color: white !important;
}

/* Эффекты наведения для системных кнопок в шапке */
QPushButton#window_close_button:hover {
    background-color: #E81123 !important;
    color: white !important;
}

TopBar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1); /* Легкая подсветка для обычных кнопок окон */
}

/* Для светлой темы лучше использовать темный налет при наведении: */
/* background-color: rgba(0, 0, 0, 0.05); */

/* Стандартное поведение кнопок окон Windows */
QPushButton#window_min_button, 
QPushButton#window_max_button, 
QPushButton#window_close_button {
    border: none;
    background: transparent;
    color: #212529; /* Сделай черным (#000000) для светлой темы light.qss */
    font-size: 11px;
}

/* Эффект наведения для Свернуть и Развернуть (светло-серый налет) */
QPushButton#window_min_button:hover, 
QPushButton#window_max_button:hover {
    background-color: rgba(0, 0, 0, 0.08); /* Для светлой темы используй: rgba(0,0,0,0.08) */
}

/* Эффект наведения для кнопки Закрыть (фирменный виндовый красный) */
QPushButton#window_close_button:hover {
    background-color: #E81123 !important;
    color: #FFFFFF !important;
}
